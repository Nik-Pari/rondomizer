{
  "name": "rondomizer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Рондомайзер — офлайн-ротация пар для тренировок West Coast Swing",
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "tsc --noEmit && vite build --configLoader native",
    "build:single": "tsc --noEmit && vite build --config vite.config.singlefile.ts --configLoader native --mode singlefile",
    "preview": "vite preview --configLoader native",
    "test": "vitest run --configLoader native",
    "test:watch": "vitest --configLoader native",
    "icons": "node scripts/make-icons.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "package:single": "npm run build:single && node scripts/package.mjs --single"
  },
  "dependencies": {
    "lz-string": "1.5.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/archiver": "6.0.3",
    "@types/lz-string": "1.5.0",
    "@types/node": "24.10.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "archiver": "8.0.0",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "3.2.7"
  }
}
